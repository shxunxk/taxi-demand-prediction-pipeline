AIRFLOW_UID=50000

# GitHub ML code repo — pushed code is what Airflow runs
GITHUB_REPO_URL=https://github.com/your-org/your-ml-repo.git
GIT_BRANCH=main

# Where data/ windowData/ models/ metadata/ mlflow/ live on your PC.
# Use a path outside the airflow project to mirror production-style separation.
PIPELINE_DATA_HOST_DIR=..

_PIP_ADDITIONAL_REQUIREMENTS=pandas pyarrow xgboost scikit-learn mlflow joblib boto3
MLFLOW_TRACKING_URI=file:///opt/airflow/mlflow

# --- Object storage (use with: docker compose -f docker-compose.yaml -f docker-compose.objectstore.yaml up -d)
# Separate compose file = separate data-plane lifecycle (typical in industry: S3 is not “inside” Airflow).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-root-minio
MINIO_PIPELINE_ACCESS_KEY=pipeline-access-key
MINIO_PIPELINE_SECRET_KEY=change-me-pipeline-secret-16chars

MINIO_BUCKET_RAW=taxi-raw
MINIO_BUCKET_ML=ml-artifacts
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Apps inside Docker use service DNS; boto3 endpoint (passed to workers)
S3_ENDPOINT_URL=http://minio:9000
